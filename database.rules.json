{
  "rules": {
    "schedule": {
      ".read": true,
      "courses": {
        "$courseId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['title', 'term', 'number', 'meets'])"
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
